APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Режим журналу SQLite. WAL (за замовчуванням у config/database.php) потрібен
# тому, що до бази одночасно пишуть три queue-воркери, PHP-FPM і планувальник.
# УВАГА: у WAL частина даних лежить у файлі database.sqlite-wal, тому бекап
# копіюванням лише database.sqlite може загубити свіжі транзакції — бекапити
# треба через `sqlite3 database.sqlite ".backup out.sqlite"` (див. DEPLOY.md).
# DB_JOURNAL_MODE=WAL
# Скільки мілісекунд чекати зайняту базу, перш ніж впасти з «database is locked».
# DB_BUSY_TIMEOUT=10000
# Режим старту транзакцій. IMMEDIATE бере лок на запис одразу, тому DB_BUSY_TIMEOUT
# реально чекає; при DEFERRED перехід читання→запис падає миттєво, повз таймаут.
# DB_TRANSACTION_MODE=IMMEDIATE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Пошта. MAIL_MAILER=log лише пише листи в storage/logs — для листів керівнику
# про критичні порушення (див. ViolationAlertService) на проді потрібен smtp:
# MAIL_MAILER=smtp, MAIL_HOST/PORT/USERNAME/PASSWORD провайдера і MAIL_SCHEME=smtps
# для порту 465. Саму адресу керівник вписує в інтерфейсі («Працівники» →
# «Сповіщення про порушення»), а не тут.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Yaware worker
YAWARE_EMAIL=
YAWARE_PASSWORD=
YAWARE_HEADLESS=true

# Trello (https://trello.com/power-ups/admin -> API key; у Allowed Origins ключа додайте origin SPA,
# наприклад http://localhost:5173 — інакше authorize-редірект на /trello/callback не спрацює)
TRELLO_API_KEY=
# Legacy-fallback для користувачів без підключеного Trello-акаунта; після повного переходу прибрати.
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=3liiIWVx
# Дошка-шаблон для «Створити дошку» (списки й мітки клонуються, картки — ні).
TRELLO_TEMPLATE_BOARD_ID=
TRELLO_TIMEZONE=Europe/Kyiv

# Бітрікс24 — альтернатива Trello, вибирає кожен працівник у себе в інтеграціях.
# Секретів тут немає: портал команди підключає адміністратор в інтерфейсі
# (вхідний вебхук, зберігається зашифрованим у БД). Часовий пояс планових дат
# тасок; якщо не задано — береться TRELLO_TIMEZONE.
BITRIX_TIMEZONE=Europe/Kyiv


# Google Sheets (OAuth-клієнт «Web application» з Google Cloud Console;
# після заповнення авторизуйтесь один раз на http://localhost:8000/google/auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI-аналітика робочого дня. Провайдер за замовчуванням: anthropic | deepseek.
# Він працює у фоні після звіту; в інтерфейсі поруч із кнопкою «Проаналізувати»
# можна разово обрати інший, а порівняти обох на одному дні —
# php artisan ai:compare <employee_id> <YYYY-MM-DD>.
AI_PROVIDER=anthropic

# Claude API (ключ з https://platform.claude.com, розділ API Keys; потребує
# кредитів на балансі — підписка Pro/Max не рахується).
# Без жодного ключа розділ аналітики неактивний, решта сервісу працює як раніше.
ANTHROPIC_API_KEY=
# Модель і глибина міркування (low | medium | high | xhigh | max).
# claude-sonnet-5 — баланс ціни та якості для цієї задачі; claude-opus-5
# дорожчий і глибший, claude-haiku-4-5 напряму не підійде (не підтримує
# effort і adaptive thinking — знадобляться правки в AiAnalysisService).
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# DeepSeek — дешевша альтернатива для тих самих розборів (ключ з
# https://platform.deepseek.com). Веб-пошуку в API немає, тому незнайомі домени
# модель має лишати з вердиктом «Невідомо», а не здогадуватись.
DEEPSEEK_API_KEY=
# deepseek-chat (псевдонім, наразі веде на deepseek-v4-flash) — швидкий і дешевий;
# deepseek-reasoner міркує глибше, але довше.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram (бот для сповіщень; створюється через @BotFather)
TELEGRAM_BOT_TOKEN=
# Username бота без @ — використовується в deep-link t.me/<bot>?start=<код>
TELEGRAM_BOT_USERNAME=
# Довільний секрет, який Telegram шле в заголовку кожного вебхука
# (згенерувати: openssl rand -hex 32); після заповнення — php artisan telegram:set-webhook
TELEGRAM_WEBHOOK_SECRET=
# Пошта того, кому йдуть ТЕХНІЧНІ сповіщення: підсумок ранкової автогенерації
# (щобудня — він же сигнал живості планувальника) і падіння самої команди.
# Це службовий канал на одну людину — розробника; працівникам ці повідомлення
# не йдуть. У користувача з цією поштою має бути привʼязаний Telegram
# (сторінка «Інтеграції» → Telegram), інакше сповіщення нікуди не підуть —
# у лог тоді пишеться попередження. Порожнє значення вимикає їх повністю.
OPS_TELEGRAM_EMAIL=
# Зовнішній сигнал живості: URL перевірки з healthchecks.io (безкоштовний тариф)
# або аналога. Сервіс пінгує його щопівгодини командою ops:healthcheck.
# Потрібен саме зовнішній сервіс: якщо ляже сам сервер, cron або PHP, надіслати
# сповіщення з нього буде нікому — тривогу має підняти той, хто чекає пінга
# ззовні. Порожнє значення вимикає механізм.
OPS_HEARTBEAT_URL=
